#set terminal x11 1
#set terminal postscript portrait color solid "Times-Roman" 18 size 10 in, 6.68 in
set terminal postscript portrait color solid "Times-Roman" 18 size 8.88889 in, 6.68 in
#set terminal postscript portrait color solid "Times-Roman" 18 size 10.0 in, 10.0 in

#__________________________________
# generate the  plot script
set autoscale
set ytics
set xtics
set mxtics
set mytics
#set grid xtics ytics
set pointsize 1.0

#__________________________________
#   Pressure
#__________________________________
set key top right
set output "ConductionResults.ps"
set xrange [0.0:120]
set yrange [200.0:1800]
set xlabel "Time (s)"
set ylabel "Temperature (K)"
set arrow from 60,200 to 60, 1800 nohead lw 3 lc rgb 'black' front

plot \
       "t49.out" using 1:2 w l lw 3 lc "green"  t "0.1 cm",\
       "t48.out" using 1:2 w l lw 3 lc "blue"   t "0.2 cm",\
       "t46.out" using 1:2 w l lw 3 lc "orange" t "0.4 cm",\
       "t42.out" using 1:2 w l lw 3 lc "purple" t "0.8 cm",\
       "t38.out" using 1:2 w l lw 3 lc "cyan"   t "1.2 cm",\
       "t34.out" using 1:2 w l lw 3 lc "red"    t "1.6 cm",\
       "t26.out" using 1:2 w l lw 3 lc "gray"   t "2.4 cm"
pause -1
