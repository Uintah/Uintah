<?xml version="1.0" encoding="UTF-8"?>
<!-- @version: -->
<Uintah_specification>

  <Meta>
    <title> Exploding Container 2-D Using Steady Burn Model </title>
  </Meta>

  <SimulationComponent type="mpmice" />

  <!--____________________________________________________________________-->
  <!--   T  I  M  E     V  A  R  I  A  B  L  E  S                         -->
  <!--____________________________________________________________________-->
  <Time>
    <maxTime>             0.1      </maxTime>
    <initTime>            0.0       </initTime>
    <delt_min>            0.0       </delt_min>
    <delt_max>            1.0e-5    </delt_max>
    <delt_init>           1.0e-10    </delt_init>
    <max_Timesteps>       10000000  </max_Timesteps>
<!--
    <max_delt_increase>   0.7       </max_delt_increase>
-->
    <timestep_multiplier> 0.20      </timestep_multiplier>
  </Time>

  <!--____________________________________________________________________-->
  <!--   G  R  I  D     V  A  R  I  A  B  L  E  S                         -->
  <!--____________________________________________________________________-->
  <Grid>
    <BoundaryConditions>
      <Face side="x-">
        <BCType id="all" label="Symmetric" var="symmetry"> </BCType>
      </Face>
      <Face side="x+">
        <BCType id = "all"   label = "Pressure"     var = "Dirichlet">
                              <value> 101325. </value>
        </BCType>
        <BCType id = "all"   label = "Velocity"     var = "Neumann">
                              <value> [0.,0.,0.] </value>
        </BCType>
        <BCType id = "all"   label = "Temperature"  var = "Neumann">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "all"   label = "Density"      var = "Neumann">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "all" label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0  </value>
        </BCType>
      </Face>
      <Face side="y-">
        <BCType id="all" label="Symmetric" var="symmetry"> </BCType>
      </Face>
      <Face side="y+">
        <BCType id="all" label="Symmetric" var="symmetry"> </BCType>
      </Face>
      <Face side="z-">
        <BCType id="all" label="Symmetric" var="symmetry"> </BCType>
      </Face>
      <Face side="z+">
        <BCType id="all" label="Symmetric" var="symmetry"> </BCType>
      </Face>
    </BoundaryConditions>
    <Level>
      <Box label="1">
        <lower>        [ 0.000, -0.0005, -0.0005]    </lower>
        <upper>        [ 0.070,  0.0005,  0.0005]    </upper>
        <extraCells>   [ 1, 1, 1]                   </extraCells>
        <patches>      [ 1, 1, 1]                   </patches>
        <resolution>   [ 70, 1, 1]               </resolution>
      </Box>
      <periodic>       [0,0,0]           </periodic>
    </Level>
  </Grid>

  <!--____________________________________________________________________-->
  <!--   O  U  P  U  T     V  A  R  I  A  B  L  E  S                      -->
  <!--____________________________________________________________________-->
  <DataArchiver>
    <filebase>StickMPMICE.uda</filebase>
    <outputInterval> 1e-3 </outputInterval>
    <compression> gzip </compression>
    <save label="p.x"/>
    <save label="p.mass"/>
    <save label="p.velocity"/>
    <save label="p.surface"/>
    <save label="p.scalefactor"/>
    <save label="p.deltaMass"/>
    <save label="TotalMass"/>
    <save label = "press_CC"/>
    <save label = "press_equil_CC"/>
    <save label = "delP_MassX"/>
    <save label = "TMV_CC"/>
    <save label = "vol_frac_CC"/>
    <save label = "rho_CC"/>
    <save label = "sp_vol_CC"/>
    <save label = "delP_Dilatate"/>
    <save label = "speedSound_CC"/>
    <save label = "intE_source_CC"/>
    <save label = "eng_L_ME_CC"/>
    <save label = "mom_L_ME_CC"/>
    <save label = "vel_CC"/>
    <save label = "temp_CC"/>
<!--
    <save label="p.temperature"/>
    <save label="p.velocity"/>
    <save label="p.stress"/>
    <save label="g.mass"/>
    <save label= "g.stressFS"/>
    <save label= "delP_Dilatate"/>
    <save label= "delP_MassX"/>
    <save label= "mom_source_CC"/>
    <save label= "intE_source_CC"/>
    <save label= "p.localizedMPM"/>
-->
    <!-- <checkpoint cycle="1" timestepInterval="3000"/> -->
    <checkpoint cycle="1" interval="1.e-3"/>
  </DataArchiver>

    <CFD>
       <cfl>0.4</cfl>
       <ICE>
        <advection type = "SecondOrder"/>
        <ClampSpecificVolume> true </ClampSpecificVolume>
     <!--   
        <TimeStepControl>
          <Scheme_for_delT_calc> conservative   </Scheme_for_delT_calc>
          <knob_for_speedSound>  0.1            </knob_for_speedSound>
        </TimeStepControl>
        <ImplicitSolver>
           <max_outer_iterations>      4    </max_outer_iterations>
           <outer_iteration_tolerance> 1e-8 </outer_iteration_tolerance>
           <iters_before_timestep_restart> 5 </iters_before_timestep_restart>
           <Parameters variable = "implicitPressure">
            <solver>         cg      </solver>
            <preconditioner> pfmg    </preconditioner>
            <tolerance>      1.e-10  </tolerance>
            <maxiterations>  7500    </maxiterations>
            <npre>           1       </npre>
            <npost>          1       </npost>
            <skip>           0       </skip>
            <jump>           0       </jump>

            </Parameters>
        </ImplicitSolver>
     -->
      </ICE>
    </CFD>

  <!--____________________________________________________________________-->
  <!--     P  H  Y  S  I  C  A  L     C  O  N  S  T  A  N  T  S           -->
  <!--____________________________________________________________________-->
  <PhysicalConstants>
    <gravity>            [0,0,0]   </gravity>
    <reference_pressure> 101325.0  </reference_pressure>
  </PhysicalConstants>

  <MPM>
    <time_integrator>               explicit    </time_integrator>
    <interpolator>                  gimp        </interpolator>
    <minimum_particle_mass>         3.e-12       </minimum_particle_mass>
    <artificial_damping_coeff>      0.0         </artificial_damping_coeff>
<!--
    <artificial_viscosity>          true        </artificial_viscosity>
    <artificial_viscosity_coeff1>   0.07        </artificial_viscosity_coeff1>
    <artificial_viscosity_coeff2>   1.6         </artificial_viscosity_coeff2>
-->
    <use_load_curves>               false       </use_load_curves>
    <do_contact_friction_heating>   false       </do_contact_friction_heating>
    <testForNegTemps_mpm>           false       </testForNegTemps_mpm>
  </MPM>


  <!--____________________________________________________________________-->
  <!--    MATERIAL PROPERTIES INITIAL CONDITIONS                          -->
  <!--____________________________________________________________________-->
  <MaterialProperties>
    <MPM>
      <material name="Reactant">
        <density>              1000.0 </density>
        <thermal_conductivity> 0.0    </thermal_conductivity>
        <specific_heat>        996.0  </specific_heat>

        <constitutive_model type = "UCNH">
          <bulk_modulus>  1.0e8  </bulk_modulus>
          <shear_modulus> 6.5e7  </shear_modulus>
          <useModifiedEOS>  true </useModifiedEOS>
        </constitutive_model>

        <geom_object>
            <box label="HMX">
              <min>   [-.05, -1.0, -1.0] </min>
              <max>   [0.05,  1.0,  1.0] </max>
            </box>
          <res>              [2,1,1]         </res>
          <velocity>         [0.0,0.0,0.0]   </velocity>
          <temperature>      300.0           </temperature>
        </geom_object>
      </material>

      <contact>
        <type>       null      </type>
        <materials>  [0,1]     </materials>
      </contact>
      <dissolution>
        <type>       particleBasedDissolution      </type>
        <dLdt> 0.1 </dLdt>
      </dissolution>
    </MPM>

    <ICE>
       <material name = "Product">
         <EOS type = "ideal_gas">                     </EOS>
         <dynamic_viscosity>          0.0             </dynamic_viscosity>
         <thermal_conductivity>       0.0             </thermal_conductivity>
         <specific_heat>              716.0           </specific_heat>
         <gamma>                      1.4             </gamma>
         <geom_object>
              <box>
               <min>   [ 0.05, -1.0, -1.0]      </min>
               <max>   [ 0.10,  1.0,  1.0]      </max>
              </box>

             <res>                  [2,1,1]           </res>
             <velocity>             [0.0,0.0,0.0]     </velocity>
             <temperature>          300.0             </temperature>
            <density>               1.179294693       </density>
             <pressure>              101325.          </pressure>
         </geom_object>
       </material>
    </ICE>

     <exchange_properties>
       <exchange_coefficients>
                        <!--  [0-1]  -->
            <momentum>       [1e15]     </momentum>
            <heat>           [   1]     </heat>
        </exchange_coefficients>
     </exchange_properties>
  </MaterialProperties>

  <!--______________________________________________________________________--> 
  <Models>
    <Model type="Ablation0">
      <Ablation0>
        <fromMaterial>         Reactant     </fromMaterial>
        <toMaterial>           Product      </toMaterial>

        <E0>                    8.314        </E0>
      </Ablation0>
    </Model>
  </Models>
</Uintah_specification>
