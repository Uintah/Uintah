<?xml version="1.0" encoding="iso-8859-1"?>


<!-- @version: -->

<Uintah_specification>
    <!--
     2D (x-z plane) linear-acoustics reflection-coefficient test for the
     LODI outflow boundary condition - the x-z-plane sibling of
     Lodi_reflectionCoeff_2D_xy.ups. Same construction, just with z taking
     the role y played there (z is now the second active axis; y is the
     thin, symmetric direction). See that file for the full rationale;
     only the geometry below differs.

     Tests the x+ boundary again (not a new boundary), so by the gas's
     isotropy this should reproduce the x-y plane test's |R| exactly -
     a cross-check of the implementation (different domain orientation,
     different patch decomposition) analogous to how the 1D family's
     dy/dz tests cross-check dx.

     The pulse sits on the domain's z-centerline (z = L/2), and so does
     the probe - by the z-mirror symmetry of a pulse centered there, the
     z-component of velocity is exactly zero along that whole line, so
     the same right-/left-going Riemann-invariant decomposition used by
     the 1D tests (using only vx) remains exact for isolating the x+
     reflection, even though the wave itself is genuinely 2D.

     All four x-/x+/z-/z+ faces are LODI; y-/y+ are symmetric (thin
     direction). Geometry chosen so the z-wall and x- wall reflections
     arrive well after the x+ reflection being measured:

       L = 1.0, x_spike = 0.6, x_probe = 0.8, z = L/2 = 0.5 (both)
       t1 (incident, direct)         = (x_probe - x_spike)/c0        = 7.40e-4 s
       t2 (x+ reflection, measured)  = (2L - x_spike - x_probe)/c0   = 2.22e-3 s
       t_z (z-wall reflection)       = sqrt((x_probe-x_spike)^2+L^2)/c0 = 3.78e-3 s
       t3 (x- wall reflection)       = (x_spike + x_probe)/c0        = 5.18e-3 s
       (c0 = sqrt(gamma*(gamma-1)*cv*300) = 270.12 m/s for this gas)

     See Lodi_reflectionCoeff_2D_xy.ups for the image-source derivation
     of t_z/t3; it's identical here with z in place of y.

     Post-process with
     compute_LODI_reflectionCoeff.py -dir x -index 160 0 100 -window <lo> <hi>
     (see that script's docstring; index 160 along x is the cell nearest
     x=0.8 m, index 100 along z is the cell nearest z=0.5 m at this
     resolution; index 0 along y is the thin domain's only cell).

     References: see Lodi_reflectionCoeff_2D_xy.ups.
    -->
   <Meta>
       <title>LODI outflow reflection-coefficient test (2D, x-z plane)</title>
   </Meta>
   <SimulationComponent type="ice" />
    <!--____________________________________________________________________-->
    <!--      T  I  M  E     V  A  R  I  A  B  L  E  S                      -->
    <!--____________________________________________________________________-->
   <Time>
       <maxTime>            0.0030       </maxTime>
       <initTime>           0.0          </initTime>
       <delt_min>           0.0          </delt_min>
       <delt_max>           1.0          </delt_max>
       <delt_init>          1.0e-7       </delt_init>
       <timestep_multiplier>1.0          </timestep_multiplier>
   </Time>
    <!--____________________________________________________________________-->
    <!--   B O U N D A R Y   C O N D I T I O N S                            -->
    <!--____________________________________________________________________-->

    <Grid>
    <BoundaryConditions>

      <LODI>
        <press_infinity>  101325.0  </press_infinity>
        <sigma>           0.27      </sigma>
        <material>       atmosphere </material>
      </LODI>

      <Face side = "x-">
        <BCType id = "0"   label = "Pressure"     var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Velocity"     var = "LODI">
                              <value> [0.0,0.0,0.0] </value>
        </BCType>
        <BCType id = "0"   label = "Temperature"  var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Density"      var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0 </value>
        </BCType>
      </Face>
      <Face side = "x+">
        <BCType id = "0"   label = "Pressure"     var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Velocity"     var = "LODI">
                              <value> [0.0,0.0,0.0] </value>
        </BCType>
        <BCType id = "0"   label = "Temperature"  var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Density"      var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0 </value>
        </BCType>
      </Face>

      <Face side = "y-">
        <BCType id = "0"   label = "Symmetric" var = "symmetry">
        </BCType>
      </Face>
      <Face side = "y+">
        <BCType id = "0"   label = "Symmetric" var = "symmetry">
        </BCType>
      </Face>

      <Face side = "z-">
        <BCType id = "0"   label = "Pressure"     var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Velocity"     var = "LODI">
                              <value> [0.0,0.0,0.0] </value>
        </BCType>
        <BCType id = "0"   label = "Temperature"  var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Density"      var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0 </value>
        </BCType>
      </Face>
      <Face side = "z+">
        <BCType id = "0"   label = "Pressure"     var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Velocity"     var = "LODI">
                              <value> [0.0,0.0,0.0] </value>
        </BCType>
        <BCType id = "0"   label = "Temperature"  var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Density"      var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0 </value>
        </BCType>
      </Face>

    </BoundaryConditions>
    <!--____________________________________________________________________-->
    <!--      G  R  I  D     V  A  R  I  A  B  L  E  S                      -->
    <!--____________________________________________________________________-->
       <Level>
           <Box label="1">
              <lower>        [0,    0,     0]    </lower>
              <upper>        [1.0,  0.005, 1.0]  </upper>
              <extraCells>   [1,1,1]             </extraCells>
              <patches>      [4,1,4]             </patches>
              <resolution>   [200,1,200]         </resolution>
           </Box>
       </Level>
    </Grid>

    <!--____________________________________________________________________-->
    <!--      O  U  P  U  T     V  A  R  I  A  B  L  E  S                   -->
    <!--____________________________________________________________________-->
   <DataArchiver>
      <filebase>Lodi_reflectionCoeff_2D_xz.uda</filebase>
      <outputInterval> 0.0005 </outputInterval>
      <save label="vel_CC"/>
      <save label="press_CC"/>
   </DataArchiver>

    <!--____________________________________________________________________-->
    <!--    I  C  E     P  A  R  A  M  E  T  E  R  S                        -->
    <!--____________________________________________________________________-->
    <CFD>
         <cfl>0.2</cfl>
       <ICE>
        <advection type = "SecondOrder" />

        <customInitialization>
          <gaussianTemperature>
            <origin>     [0.6, 0.0025, 0.5]  </origin>
            <amplitude>  5.0                 </amplitude>
            <spread_x>   0.03                </spread_x>
            <spread_y>   10.0                </spread_y>
            <spread_z>   0.03                </spread_z>
          </gaussianTemperature>
        </customInitialization>
      </ICE>
    </CFD>

    <!--____________________________________________________________________-->
    <!--     P  H  Y  S  I  C  A  L     C  O  N  S  T  A  N  T  S           -->
    <!--____________________________________________________________________-->
    <PhysicalConstants>
       <gravity>[0,0,0]</gravity>
       <reference_pressure> 101325 </reference_pressure>
    </PhysicalConstants>

    <!--____________________________________________________________________-->
    <!--     MATERIAL PROPERTIES AND INITIAL CONDITIONS                     -->
    <!--____________________________________________________________________-->
    <MaterialProperties>
       <ICE>
         <material name="atmosphere">
           <EOS type = "ideal_gas"/>
          <dynamic_viscosity>     0.0    </dynamic_viscosity>
          <thermal_conductivity>  0.0    </thermal_conductivity>
          <specific_heat>         652.9  </specific_heat>
          <gamma>                 1.289  </gamma>

           <geom_object>
             <box label="Whole grid">
               <min>  [-2.0,-2.0,-2.0]  </min>
               <max>  [ 4.0, 4.0, 4.0]  </max>
             </box>
             <res>          [2,2,2]                </res>
             <velocity>     [0.0,0.0,0.0]          </velocity>
             <density>      1.7899909957225715000  </density>
             <pressure>     101325.0               </pressure>
             <temperature>  300.0                  </temperature>
           </geom_object>
         </material>
      </ICE>
    </MaterialProperties>

    <!--____________________________________________________________________-->
    <!--      D  A  T  A     A  N  A  L  Y  S  I  S                         -->
    <!--____________________________________________________________________-->
    <!--
     Point probe at (x,z) = (0.8, 0.5) m, on the
     z-centerline (see the header comment for why that placement keeps
     the 1D Riemann-invariant decomposition exact).
     (dx=0.005, cell 160: [0.800,0.805]), pinned at the exact z-center value (cell 100's
     center, z=0.5025).
     Written to uda/probe/L-0/i160_j0_k100.
    -->
    <DataAnalysis>
      <Module name = "lineExtract">
        <material>           atmosphere  </material>
        <samplingFrequency>  1e7         </samplingFrequency>
        <timeStart>          0           </timeStart>
        <timeStop>           1.0         </timeStop>

        <Variables>
          <analyze label = "press_CC" matl = "0"/>
          <analyze label = "vel_CC"   matl = "0"/>
        </Variables>

        <lines>
          <line name = "probe">
            <startingPt>  [0.800, 0.0025, 0.5025]  </startingPt>
            <endingPt>    [0.805, 0.0025, 0.5025]  </endingPt>
          </line>
        </lines>
      </Module>
    </DataAnalysis>
</Uintah_specification>
