<?xml version="1.0" encoding="iso-8859-1"?>


<!-- @version: -->

<Uintah_specification>
    <!--
     2D (x-y plane) linear-acoustics reflection-coefficient test for the
     LODI outflow boundary condition - the genuinely-2D counterpart of
     the 1D Lodi_reflectionCoeff.ups family. There, the pulse and the
     boundary interaction are both planar (1D), by construction. Here, a
     radially-expanding (cylindrical) pulse hits the x+ boundary at a
     continuum of incidence angles rather than head-on, which is a more
     realistic test of a boundary condition derived under the 1D LODI
     approximation (it drops the transverse terms that a curved wavefront
     actually has).

     The pulse sits on the domain's y-centerline (y = L/2), and so does
     the probe - by the y-mirror symmetry of a pulse centered there, the
     y-component of velocity is exactly zero along that whole line, so
     the same right-/left-going Riemann-invariant decomposition used by
     the 1D tests (using only vx) remains exact for isolating the x+
     reflection, even though the wave itself is genuinely 2D.

     All four x-/x+/y-/y+ faces are LODI (matching how a real 2D domain
     would normally be bounded), which means reflections from the y-, y+
     and x- faces will eventually reach the probe too - this geometry is
     chosen so they arrive well after the x+ reflection being measured:

       L = 1.0, x_spike = 0.6, x_probe = 0.8, y = L/2 = 0.5 (both)
       t1 (incident, direct)         = (x_probe - x_spike)/c0        = 7.40e-4 s
       t2 (x+ reflection, measured)  = (2L - x_spike - x_probe)/c0   = 2.22e-3 s
       t_y (y-wall reflection)       = sqrt((x_probe-x_spike)^2+L^2)/c0 = 3.78e-3 s
       t3 (x- wall reflection)       = (x_spike + x_probe)/c0        = 5.18e-3 s
       (c0 = sqrt(gamma*(gamma-1)*cv*300) = 270.12 m/s for this gas)

     t_y and t3 come from the standard image-source construction: the
     wavefront that returns from reflecting off a wall arrives as if it
     came from the pulse's mirror image across that wall, at the
     corresponding distance over c0. With t1 < t2 < t_y < t3 and
     reasonable margins, the window around t2 used to find the reflected
     peak (see Lodi_reflectionCoeff_2D_xy.tst's -window argument) is free
     of contamination from the other three boundaries.

     Post-process with
     compute_LODI_reflectionCoeff.py -dir x -probe 160 -window <lo> <hi>
     (see that script's docstring; -probe 160 is the cell nearest
     x=0.8 m at this resolution).

     References:
     [1] J.C. Sutherland, C.A. Kennedy, "Improved boundary conditions for
         viscous, reacting, compressible flows," Journal of Computational
         Physics, 191(2):502-524, 2003. (doi:10.1016/j.jcp.2003.06.001)
         - the LODI formulation this .ups exercises (CCA/Components/ICE/
         CustomBCs/LODI2.cc cites this paper's Table 5 and Eq. 8-9
         directly); their own validation includes a 2D premixed flame
         case reaching all four domain boundaries, the same spirit as
         this test.

     [2] T.J. Poinsot, S.K. Lele, "Boundary conditions for direct
         simulations of compressible viscous flows," Journal of
         Computational Physics, 101(1):104-129, 1992.
         (doi:10.1016/0021-9991(92)90046-2) - origin of the NSCBC outflow
         relaxation approach and the acoustic-pulse/vortex-convection
         reflection benchmark this test is modeled on.

     [3] D.H. Rudy, J.C. Strikwerda, "A nonreflecting outflow boundary
         condition for subsonic Navier-Stokes calculations," Journal of
         Computational Physics, 36(1):55-70, 1980.
         (doi:10.1016/0021-9991(80)90174-6) - source of the sigma*c*(1-M^2)
         outflow relaxation term and the sigma ~ 0.25-0.28 recommendation.

     [4] C.S. Yoo, H.G. Im, "Characteristic boundary conditions for
         simulations of compressible reacting flows with multi-dimensional,
         viscous and reaction effects," Combustion Theory and Modelling,
         11(2):259-286, 2007. (doi:10.1080/13647830600898995) - this
         family's wave-amplitude-decomposition-at-a-probe methodology
         follows this paper's validation approach; its own test suite
         includes a genuinely 2D vortex-convection case for the same
         reason this one does - a planar/1D test alone doesn't exercise
         the boundary's handling of transverse gradients.
    -->
   <Meta>
       <title>LODI outflow reflection-coefficient test (2D, x-y plane)</title>
   </Meta>
   <SimulationComponent type="ice" />
    <!--____________________________________________________________________-->
    <!--      T  I  M  E     V  A  R  I  A  B  L  E  S                      -->
    <!--____________________________________________________________________-->
   <Time>
       <maxTime>            0.0030       </maxTime>
       <initTime>           0.0          </initTime>
       <delt_min>           0.0          </delt_min>
       <delt_max>           1.0          </delt_max>
       <delt_init>          1.0e-7       </delt_init>
       <timestep_multiplier>1.0          </timestep_multiplier>
   </Time>
    <!--____________________________________________________________________-->
    <!--   B O U N D A R Y   C O N D I T I O N S                            -->
    <!--____________________________________________________________________-->

    <Grid>
    <BoundaryConditions>

      <LODI>
        <press_infinity>  101325.0  </press_infinity>
        <sigma>           0.27      </sigma>
        <material>       atmosphere </material>
      </LODI>

      <Face side = "x-">
        <BCType id = "0"   label = "Pressure"     var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Velocity"     var = "LODI">
                              <value> [0.0,0.0,0.0] </value>
        </BCType>
        <BCType id = "0"   label = "Temperature"  var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Density"      var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0 </value>
        </BCType>
      </Face>
      <Face side = "x+">
        <BCType id = "0"   label = "Pressure"     var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Velocity"     var = "LODI">
                              <value> [0.0,0.0,0.0] </value>
        </BCType>
        <BCType id = "0"   label = "Temperature"  var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Density"      var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0 </value>
        </BCType>
      </Face>

      <Face side = "y-">
        <BCType id = "0"   label = "Pressure"     var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Velocity"     var = "LODI">
                              <value> [0.0,0.0,0.0] </value>
        </BCType>
        <BCType id = "0"   label = "Temperature"  var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Density"      var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0 </value>
        </BCType>
      </Face>
      <Face side = "y+">
        <BCType id = "0"   label = "Pressure"     var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Velocity"     var = "LODI">
                              <value> [0.0,0.0,0.0] </value>
        </BCType>
        <BCType id = "0"   label = "Temperature"  var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "Density"      var = "LODI">
                              <value> 0.0 </value>
        </BCType>
        <BCType id = "0"   label = "SpecificVol"  var = "computeFromDensity">
                              <value> 0.0 </value>
        </BCType>
      </Face>

      <Face side = "z-">
        <BCType id = "0"   label = "Symmetric" var = "symmetry">
        </BCType>
      </Face>
      <Face side = "z+">
        <BCType id = "0"   label = "Symmetric" var = "symmetry">
        </BCType>
      </Face>

    </BoundaryConditions>
    <!--____________________________________________________________________-->
    <!--      G  R  I  D     V  A  R  I  A  B  L  E  S                      -->
    <!--____________________________________________________________________-->
       <Level>
           <Box label="1">
              <lower>        [0,    0,    0]     </lower>
              <upper>        [1.0,  1.0,  0.005] </upper>
              <extraCells>   [1,1,1]             </extraCells>
              <patches>      [4,4,1]             </patches>
              <resolution>   [200,200,1]         </resolution>
           </Box>
       </Level>
    </Grid>

    <!--____________________________________________________________________-->
    <!--      O  U  P  U  T     V  A  R  I  A  B  L  E  S                   -->
    <!--____________________________________________________________________-->
   <DataArchiver>
      <filebase>Lodi_reflectionCoeff_2D_xy.uda</filebase>
      <outputInterval> 0.0005 </outputInterval>
      <save label="vel_CC"/>
      <save label="press_CC"/>
   </DataArchiver>

    <!--____________________________________________________________________-->
    <!--    I  C  E     P  A  R  A  M  E  T  E  R  S                        -->
    <!--____________________________________________________________________-->
    <CFD>
         <cfl>0.2</cfl>
       <ICE>
        <advection type = "SecondOrder" />

        <customInitialization>
          <gaussianTemperature>
            <origin>     [0.6, 0.5, 0.0025]  </origin>
            <amplitude>  5.0                 </amplitude>
            <spread_x>   0.03                </spread_x>
            <spread_y>   0.03                </spread_y>
            <spread_z>   10.0                </spread_z>
          </gaussianTemperature>
        </customInitialization>
      </ICE>
    </CFD>

    <!--____________________________________________________________________-->
    <!--     P  H  Y  S  I  C  A  L     C  O  N  S  T  A  N  T  S           -->
    <!--____________________________________________________________________-->
    <PhysicalConstants>
       <gravity>[0,0,0]</gravity>
       <reference_pressure> 101325 </reference_pressure>
    </PhysicalConstants>

    <!--____________________________________________________________________-->
    <!--     MATERIAL PROPERTIES AND INITIAL CONDITIONS                     -->
    <!--____________________________________________________________________-->
    <MaterialProperties>
       <ICE>
         <material name="atmosphere">
           <EOS type = "ideal_gas"/>
          <dynamic_viscosity>     0.0    </dynamic_viscosity>
          <thermal_conductivity>  0.0    </thermal_conductivity>
          <specific_heat>         652.9  </specific_heat>
          <gamma>                 1.289  </gamma>

           <geom_object>
             <box label="Whole grid">
               <min>  [-2.0,-2.0,-2.0]  </min>
               <max>  [ 4.0, 4.0, 4.0]  </max>
             </box>
             <res>          [2,2,2]                </res>
             <velocity>     [0.0,0.0,0.0]          </velocity>
             <density>      1.7899909957225715000  </density>
             <pressure>     101325.0               </pressure>
             <temperature>  300.0                  </temperature>
           </geom_object>
         </material>
      </ICE>
    </MaterialProperties>

    <!--____________________________________________________________________-->
    <!--      D  A  T  A     A  N  A  L  Y  S  I  S                         -->
    <!--____________________________________________________________________-->
    <!--
     Point probe at (x,y) = (0.8, 0.5) m, on the
     y-centerline (see the header comment for why that placement keeps
     the 1D Riemann-invariant decomposition exact). 
     (dx=0.005, cell 160: [0.800,0.805]), pinned at the exact y-center value (cell 100's
     center, y=0.5025) ).
     Written to uda/probe/L-0/i160_j100_k0.
    -->
    <DataAnalysis>
      <Module name = "lineExtract">
        <material>           atmosphere  </material>
        <samplingFrequency>  1e7         </samplingFrequency>
        <timeStart>          0           </timeStart>
        <timeStop>           1.0         </timeStop>

        <Variables>
          <analyze label = "press_CC" matl = "0"/>
          <analyze label = "vel_CC"   matl = "0"/>
        </Variables>

        <lines>
          <line name = "probe">
            <startingPt>  [0.800, 0.5025, 0.0025]  </startingPt>
            <endingPt>    [0.805, 0.5025, 0.0025]  </endingPt>
          </line>
        </lines>
      </Module>
    </DataAnalysis>
</Uintah_specification>
