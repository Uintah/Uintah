#!/bin/bash
#SBATCH --job-name = [jobName]
#SBATCH --time     = [runTime]      # walltime
#SBATCH --output   = [output]       # stdout and stderr
#SBATCH --ntasks   = [mpiRanks]     # number of MPI tasks
# additional information for allocated clusters
#SBATCH --account  = [acct]         # account
#SBATCH --partition= [partition]    # partition


# load appropriate modules
module purge
module load gcc/11.2.0 openmpi/4.1.6 intel-oneapi-mkl/2024.0.0 hypre/2.31.0 boost/1.88.0
module list